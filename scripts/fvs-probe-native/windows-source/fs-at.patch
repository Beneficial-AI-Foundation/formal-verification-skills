     fn is_symlink(handle: HANDLE) -> Result<bool> {
+        // Query the existing handle, preserving no-follow semantics without
+        // requiring the reparse-point filesystem control operation. LPAC
+        // processes can read attributes but may not issue that FSCTL.
+        let mut attributes = MaybeUninit::<FILE_ATTRIBUTE_TAG_INFO>::uninit();
+        let bool_result = unsafe {
+            GetFileInformationByHandleEx(
+                handle,
+                FileAttributeTagInfo,
+                attributes.as_mut_ptr().cast(),
+                size_of::<FILE_ATTRIBUTE_TAG_INFO>() as u32,
+            )
+        };
+        if bool_result != 0 {
+            let attributes = unsafe { attributes.assume_init() };
+            return Ok(
+                attributes.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
+                    && matches!(
+                        attributes.ReparseTag,
+                        IO_REPARSE_TAG_SYMLINK | IO_REPARSE_TAG_MOUNT_POINT
+                    ),
+            );
+        }
+
+        // Some callers intentionally open handles without READ_ATTRIBUTES.
+        // Preserve their access contract by trying the original same-handle
+        // query rather than requesting broader permissions.
