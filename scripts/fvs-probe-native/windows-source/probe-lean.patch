+/-- Read the `LEAN_PATH` entry emitted by bare `lake env`, without depending on
+    an external `printenv` executable. Keep spaces and `=` inside path names. -/
+def leanPathFromLakeEnv (output : String) : Option String := do
+  let line ← (output.splitOn "\n").find? (·.startsWith "LEAN_PATH=")
+  return ((line.drop "LEAN_PATH=".length).toString.dropSuffix "\r").toString
+
