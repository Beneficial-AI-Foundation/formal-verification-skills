diff --git a/tests/windows_scip_paths.rs b/tests/windows_scip_paths.rs
new file mode 100644
index 0000000..56e8424
--- /dev/null
+++ b/tests/windows_scip_paths.rs
@@ -0,0 +1,92 @@
+use probe_rust::{
+    build_call_graph,
+    charon_names::{enrich_atoms, Enrichment},
+    convert_to_atoms_with_parsed_spans, parse_scip_json,
+};
+use serde_json::json;
+use std::{collections::BTreeMap, fs};
+
+fn check_scip_path(relative_path: &str) {
+    let project = tempfile::Builder::new()
+        .prefix("SCIP path with spaces ")
+        .tempdir()
+        .unwrap();
+    fs::create_dir_all(project.path().join("src/math")).unwrap();
+    fs::write(
+        project.path().join("Cargo.toml"),
+        "[package]\nname = \"path-fixture\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
+    )
+    .unwrap();
+    fs::write(project.path().join("src/lib.rs"), "pub mod math;\n").unwrap();
+    fs::write(project.path().join("src/math/mod.rs"), "pub mod field;\n").unwrap();
+    fs::write(
+        project.path().join("src/math/field.rs"),
+        "pub struct FieldElement;\npub fn reduce(_x: FieldElement) {}\n",
+    )
+    .unwrap();
+    let symbol = "rust-analyzer cargo path-fixture 0.1.0 math/field/reduce().";
+    let scip = json!({
+        "metadata": {
+            "tool_info": {"name": "rust-analyzer", "version": "fixture"},
+            "project_root": "file:///fixture", "text_document_encoding": 1
+        },
+        "documents": [{
+            "language": "rust", "relative_path": relative_path,
+            "occurrences": [
+                {"range": [1, 7, 1, 13], "symbol": symbol, "symbol_roles": 1},
+                {"range": [1, 17, 29], "symbol": "rust-analyzer cargo path-fixture 0.1.0 math/field/FieldElement#"}
+            ],
+            "symbols": [{
+                "symbol": symbol, "kind": 17, "display_name": "reduce",
+                "signature_documentation": {"language": "rust", "text": "pub fn reduce(_x: FieldElement)"}
+            }]
+        }]
+    });
+    let index_path = project.path().join("index.scip.json");
+    fs::write(&index_path, serde_json::to_vec(&scip).unwrap()).unwrap();
+    let index = parse_scip_json(&index_path).unwrap();
+    let (graph, names) = build_call_graph(&index);
+    assert_eq!(graph.len(), 1);
+    let atoms = convert_to_atoms_with_parsed_spans(&graph, &names, project.path(), false);
+    let mut atoms: BTreeMap<_, _> = atoms
+        .into_iter()
+        .map(|atom| (atom.code_name.clone(), atom))
+        .collect();
+    let manifest = json!({
+        "charon_version": "0.1.225",
+        "functions": [
+            {"def_id": 8, "rust_name": "path_fixture::math::field::reduce", "source": {"file": "path-fixture/src/math/other.rs", "begin_line": 2, "end_line": 2}},
+            {"def_id": 9, "rust_name": "path_fixture::math::field::reduce", "source": {"file": "path-fixture/src/math/field.rs", "begin_line": 30, "end_line": 31}},
+            {"def_id": 7, "rust_name": "path_fixture::math::field::reduce", "source": {"file": "path-fixture/src/math/field.rs", "begin_line": 2, "end_line": 2}}
+        ]
+    });
+    let manifest_path = project.path().join("translation.json");
+    fs::write(&manifest_path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+    let enrichment = Enrichment::from_translation_json(&manifest_path).unwrap();
+    assert_eq!(enrich_atoms(&mut atoms, &enrichment, false), 1);
+    let atom = atoms.values().next().unwrap();
+    assert_eq!(atom.charon_def_id, Some(7));
+    assert_eq!(atom.charon_version.as_deref(), Some("0.1.225"));
+    assert_eq!(atom.code_path, "src/math/field.rs");
+    assert_eq!(atom.code_text.lines_start, 2);
+    assert_eq!(atom.code_text.lines_end, 2);
+    assert_eq!(
+        graph.values().next().unwrap().definition_type_context,
+        ["FieldElement"]
+    );
+}
+
+#[test]
+fn windows_scip_paths_preserve_manifest_join_and_type_context() {
+    check_scip_path(r"src\math\field.rs");
+}
+
+#[test]
+fn mixed_scip_separators_preserve_manifest_join_and_type_context() {
+    check_scip_path(r"src\math/field.rs");
+}
+
+#[test]
+fn unix_scip_paths_preserve_manifest_join_and_type_context() {
+    check_scip_path("src/math/field.rs");
+}
